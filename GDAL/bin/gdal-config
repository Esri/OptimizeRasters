#!/bin/sh
CONFIG_LIBS="-LIBPATH:C:/Users/ptbuild/.conan2/p/b/gdal_5a11c429f1524/p/lib gdal_e"
CONFIG_DEP_LIBS="crypt32 wbemuuid $<0:CONAN_LIB::libtiff_esri_tiffxx_e_RELWITHDEBINFO CONAN_LIB::libtiff_esri_tiff_e_RELWITHDEBINFO> legacy_stdio_definitions.lib odbccp32.lib psapi version"
CONFIG_PREFIX="C:/Users/ptbuild/.conan2/p/b/gdal_5a11c429f1524/p"
CONFIG_CFLAGS="-IC:/Users/ptbuild/.conan2/p/b/gdal_5a11c429f1524/p/include"
CONFIG_DATA="C:/Users/ptbuild/.conan2/p/b/gdal_5a11c429f1524/p/share/gdal"
CONFIG_VERSION="3.12.2e"
CONFIG_GNM_ENABLED=yes
CONFIG_FORMATS="JPEG raw GTIFF MEM vrt Derived GTI NULL LIBERTIFF HFA SDTS NITF ECRGTOC RPFTOC GXF AAIGrid CEOS SAR_CEOS DTED JDEM Envisat L1B RS2 ILWIS RMF Leveller SRTMHGT IDRISI GSG ERS PALSARJaxa DIMAP GFF COSAR PDS ADRG COASP TSX Terragen MSGN TIL northwood SAGA XYZ AVIF HEIF ESRIC HF2 KMLSUPEROVERLAY CTG ZMap NGSGEOID IRIS MAP CALS SAFE SENTINEL2 PRF MRF WMTS GRIB BMP TGA STACTA SNAP_TIFF BSB AIGrid USGSDEM AirSAR PCIDSK SIGDEM RIK STACIT PDF GDALG E57 PNG GIF WCS HTTP netCDF Zarr DAAS EEDA HDF5 PLMOSAIC WMS OGCAPI WEBP HDF4 MBTiles KEA JP2OpenJPEG TileDB PCRaster JPEGXL MiraMon JP2KAK JPIPKAK MrSID ECW_JP2ECW EMITL2MIN EMIT TANAGER urlproxy Painter RCM IIQ miscmdsource RMC INGR GDALJSON GeoJSON TAB Shape KML VRT AVC GML CSV DGN GMT S57 GeoRSS DXF PGDump GPSBabel EDIGEO SXF OpenFileGDB WAsP Selafin JML VDV FlatGeobuf MapML ADBC MiraMon AIVector JSONFG GPX GMLAS CSW NAS PLSCENES WFS OAPIF NGW Elastic Idrisi PDS SQLite GeoPackage OSM VFK MVT PMTiles AmigoCloud Carto ILI MSSQLSpatial ODBC PGeo XLSX CAD Parquet Arrow GTFS ODS LVBAG"
CONFIG_PLUGINDIR="C:/Users/ptbuild/.conan2/p/b/gdal_5a11c429f1524/p/lib/gdalplugins"
usage()

{
	cat <<EOF
Usage: gdal-config [OPTIONS]
Options:
	[--prefix[=DIR]]
	[--libs]
	[--dep-libs]
	[--cflags]
	[--datadir]
	[--version]
	[--ogr-enabled]
	[--gnm-enabled]
	[--formats]
	[--plugindir]
EOF
	exit $1
}

if test $# -eq 0; then
	usage 1 1>&2
fi

case $1 in
  --libs)
    echo $CONFIG_LIBS
    ;;

  --dep-libs)
    echo $CONFIG_DEP_LIBS
    ;;

  --cflags)
    echo $CONFIG_CFLAGS
    ;;

  --datadir)
    echo $CONFIG_DATA
    ;;

  --prefix)
    echo $CONFIG_PREFIX
    ;;

  --version)
    echo $CONFIG_VERSION
    ;;

  --ogr-enabled)
    echo yes
    ;;

  --gnm-enabled)
    echo $CONFIG_GNM_ENABLED
    ;;

  --formats)
    echo $CONFIG_FORMATS
    ;;

  --plugindir)
    echo $CONFIG_PLUGINDIR
    ;;

  *)
    usage 1 1>&2
    ;;

esac
